{
  "name": "@tradecraft/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "dep-cruise": "depcruise packages",
    "models:pull": "pnpm --filter @tradecraft/llm exec tsx scripts/models-pull.ts",
    "play": "pnpm --filter @tradecraft/app exec tsx scripts/play.ts",
    "play:web": "pnpm --filter @tradecraft/web exec tsc -p tsconfig.client.json && pnpm --filter @tradecraft/app exec tsx --conditions=@tradecraft/source scripts/play-web.ts",
    "soundtrack:encode": "pnpm --filter @tradecraft/app exec tsx scripts/soundtrack-encode.ts",
    "seeds:vet": "pnpm --filter @tradecraft/app exec tsx scripts/vet-seeds.ts",
    "world": "pnpm --filter @tradecraft/evals exec tsx scripts/world.ts",
    "content": "pnpm --filter @tradecraft/content-tools exec tsx scripts/content.ts",
    "sim": "pnpm --filter @tradecraft/evals exec tsx scripts/sim.ts",
    "repl": "pnpm --filter @tradecraft/evals exec tsx scripts/repl.ts",
    "evals": "pnpm --filter @tradecraft/evals exec tsx scripts/evals.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run dep-cruise && pnpm run test"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^4.10.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.2.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
