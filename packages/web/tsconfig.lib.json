{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/lib/**/*.ts",
    "src/shared/**/*.ts",
    "src/index.ts"
  ],
  "references": [
    {
      "path": "../player-view/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/test-support/**"
  ]
}
