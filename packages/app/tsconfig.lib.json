{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../content/tsconfig.lib.json"
    },
    {
      "path": "../engine/tsconfig.lib.json"
    },
    {
      "path": "../llm/tsconfig.lib.json"
    },
    {
      "path": "../dialogue/tsconfig.lib.json"
    },
    {
      "path": "../player-view/tsconfig.lib.json"
    },
    {
      "path": "../tui/tsconfig.lib.json"
    },
    {
      "path": "../web/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/**/*.walk.ts"
  ]
}
